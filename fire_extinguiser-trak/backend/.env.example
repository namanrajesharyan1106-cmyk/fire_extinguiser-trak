ENVIRONMENT=development

# Security
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL=sqlite:///./firesafety.db

# Optional Postgres configuration (Uncomment to use PostgreSQL)
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=firesafetydb

# Default Admin Setup (Used ONLY on initial DB setup)
DEFAULT_ADMIN_EMAIL=admin@fireext.com
DEFAULT_ADMIN_PASSWORD=change_me_immediately_123
DEFAULT_ADMIN_EMPLOYEE_ID=EMP001
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_DEPARTMENT=Safety
DEFAULT_ADMIN_ROLE=ADMIN
DEFAULT_ADMIN_PLANT=Head Office

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Application Configuration
APP_TITLE=FireSafety Pro - QR Asset Management
APP_VERSION=3.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
